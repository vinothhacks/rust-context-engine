      {
        "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{WORKSPACE_PATH}}/.cursor/hooks/post-command-capture.ps1\" -BinaryPath \"{{BINARY_PATH}}\" -WorkspacePath \"{{WORKSPACE_PATH}}\""
      }
    ]
  }
}
